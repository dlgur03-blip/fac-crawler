# 실제 값은 운영 .env.local에서 복사해 .env.local 파일로 저장하세요. (이 파일은 키 이름 안내용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NAVER_USER_ID=
NAVER_USER_PW=
