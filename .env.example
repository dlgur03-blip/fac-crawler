# 실제 값은 운영 .env.local에서 복사해 .env.local 파일로 저장하세요. (이 파일은 키 이름 안내용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NAVER_USER_ID=
NAVER_USER_PW=
# 선택: 미설정 시 ./.naver_profile 사용
# NAVER_PROFILE_DIR=
# 선택: 미설정 시 28310071 (팩토리 구매대행 카페)
# NAVER_CAFE_CLUB_ID=
# 첫 로그인 캡차 처리 시에만 false로 (창 표시)
# NAVER_HEADLESS=false

# ===== 포스터(재업) 데몬 전용 =====
# 포스팅 계정 — 미설정 시 위 NAVER_USER_ID를 그대로 사용한다.
# 재업 글의 작성자가 되므로 실카페 운영 계정을 넣어야 한다.
# NAVER_POSTER_USER_ID=
# NAVER_POSTER_PW=
# 선택: 미설정 시 ./.naver_profile_poster (크롤러와 프로필 분리 — 동시 가동 시 락 충돌 방지)
# NAVER_POSTER_PROFILE_DIR=
# 포스팅 대상 카페 — 미설정 시 테스트 카페(31729221). 실운영은 28310071
# NAVER_POST_CAFE_ID=28310071
# 로그인 세션 주기 점검 간격(시간, 기본 6). 포스터는 작업이 있을 때만 로그인하므로
# 텀이 길면 네이버가 기기확인을 요구한다 → 주기적으로 세션을 살려둔다.
# SESSION_REFRESH_HOURS=6
